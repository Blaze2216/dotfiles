{
  "positionX": "right",
  "positionY": "top",

  
  "control-center-positionX": "right",
  "control-center-positionY": "top",

  
  "control-center-margin-top": 8,
  "control-center-margin-bottom": 0,
  "control-center-margin-right": 8,
  "control-center-margin-left": 0,

  
  "control-center-width": 400,
  "control-center-height": -1,       
  "fit-to-screen": false,            

  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,

  
  "control-center-exclusive-zone": true,

  
  "cssPriority": "application",
  "ignore-gtk-theme": true,


  "timeout": 5,                      
  "timeout-low": 3,                  
  "timeout-critical": 0,             

  "notification-window-width": 380,
  "notification-window-height": -1,  

  "transition-time": 200,            
  "image-visibility": "when-available",
  "notification-icon-size": 48,
  "notification-body-image-height": 100,
  "notification-body-image-width": 200,

  "notification-2fa-action": true,   
  "notification-inline-replies": false,
  "notification-grouping": true,     

  
  "keyboard-shortcuts": true,
  "hide-on-clear": false,
  "hide-on-action": true,
  "relative-timestamps": true,
  "text-empty": "No Notifications",

 
  "script-fail-notify": true,
  "scripts": {
    
  },

  
  "notification-visibility": {
    
    "mute-low-system": {
      "state": "muted",
      "app-name": "notify-send",
      "urgency": "Low"
    }
  },

  
  "notification-action-filter": {},

  
  "widgets": [
    "inhibitors",
    "title",
    "dnd",
    "mpris",
    "volume",
    "backlight",
    "buttons-grid",
    "notifications"
  ],

  
  "widget-config": {

    
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "󰗩  Clear All"
    },

   
    "dnd": {
      "text": "Do Not Disturb"
    },

   
    "inhibitors": {
      "text": "Inhibitors",
      "clear-all-button": true,
      "button-text": "󰅖  Clear"
    },

   
    "mpris": {
      "image-size": 96,
      "image-radius": 12,
      "autohide": true,
      "show-album-art": "always",
      "loop-carousel": false,
      "blacklist": ["playerctld"]
    },

    
    "volume": {
      "label": "󰕾  Volume",
      "show-per-app": true,
      "show-per-app-icon": true,
      "show-per-app-label": false,
      "expand-per-app": false,
      "expand-button-label": "⇧",
      "collapse-button-label": "⇩",
      "empty-list-label": "No active sinks",
      "animation-type": "slide_down",
      "animation-duration": 200
    },


    "backlight": {
      "label": "󰃟  Brightness",
      "device": "intel_backlight",    
      "subsystem": "backlight",
      "min": 1
    },

   
    "buttons-grid": {
      "buttons-per-row": 4,
      "actions": [
        {
          "label": "󰤨  WiFi",
          "type": "toggle",
          "active": true,
          "command": "sh -c '[[ $SWAYNC_TOGGLE_STATE == true ]] && nmcli radio wifi on || nmcli radio wifi off'",
          "update-command": "sh -c '[[ $(nmcli radio wifi) == \"enabled\" ]] && echo true || echo false'"
        },
        {
          "label": "󰂯  Bluetooth",
          "type": "toggle",
          "active": false,
          "command": "sh -c '[[ $SWAYNC_TOGGLE_STATE == true ]] && bluetoothctl power on || bluetoothctl power off'",
          "update-command": "sh -c 'bluetoothctl show | grep -q \"Powered: yes\" && echo true || echo false'"
        },
        {
          "label": "󰐥  Power",
          "type": "normal",
          "command": "wlogout"
        },
        {
          "label": "󰏗  Screenshot",
          "type": "normal",
          "command": "grimblast copy area"
        },
        {
          "label": "󰒲  Suspend",
          "type": "normal",
          "command": "systemctl suspend"
        },
        {
          "label": "󱐋  Hyprpicker",
          "type": "normal",
          "command": "hyprpicker --autocopy"
        },
        {
          "label": "󰆼  Theme",
          "type": "normal",
          "command": "nwg-look"
        },
        {
          "label": "󰁹  Battery",
          "type": "normal",
          "command": "foot -e btop"
        }
      ]
    }
  }
}