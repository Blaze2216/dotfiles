{
    "layer": "top",
    "position": "top",
    "height": 38,
    "margin-top": 0,
    "margin-bottom": 0,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 4,

    "modules-left": [],
    "modules-center": [
        "hyprland/workspaces",
        "idle_inhibitor",
        "clock",
        "custom/recorder",
        "pulseaudio",
        "network",
        "battery",
        "tray",
        "custom/notification",
        "custom/power"
    ],
    "modules-right": [],

    "hyprland/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "persistent-workspaces": {
        "*": 4
    },
    "disable-scroll": false,
    "on-scroll-up": "hyprctl dispatch workspace e+1",
    "on-scroll-down": "hyprctl dispatch workspace e-1",

    /* === Anti-jitter / smoother options === */
    "active-only": false,          // show all workspaces (helps stability)
    "all-outputs": false,          // important if you have one monitor
    "sort-by-number": true,        // prevents random reordering
    "format-icons": {
        "1": "1",
        "2": "2",
        "3": "3",
        "4": "4",
        "default": "󰊠"
    }
},

    "clock": {
        "format": " {:%b %d, %I:%M %p} ",
        "format-alt": " {:%A, %d %B %Y | %H:%M:%S} ",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "on-click": "mode"   // toggles between normal and alt format
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 Muted",
        "format-icons": ["󰕿", "󰖀", "󰕾"],
        "on-click": "pavucontrol",
        "tooltip": true
    },

    "network": {
        "format-wifi": "󰤨 {essid} {signalStrength}%",
        "format-ethernet": "󰈀 {ifname}",
        "format-linked": "󰈀 {ifname} (No IP)",
        "format-disconnected": "󰤭 Disconnected",
        "tooltip-format": "{ifname} via {gwaddr}\n{essid} {signalStrength}%",
        "on-click": "kitty --class floating_nmtui -e nmtui"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": " {capacity}%",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "on-click": "~/.config/waybar/scripts/power-menu.sh"
    },

    "tray": {
        "icon-size": 18,
        "spacing": 8,
        "show-passive-items": true
    },

    "custom/notification": {
        "tooltip": false,
        "format": "",
        "on-click": "swaync-client -t -sw",
        "escape": true,
        "return-type": "json"   // future-proof if you want dynamic count later
    },

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "󰅶",   // Solid coffee cup when caffeine is ON
            "deactivated": "󰾆" // Outline coffee cup when caffeine is OFF
        },
        "tooltip-format-activated": "Caffeine Mode: Active (Screen stays on)",
        "tooltip-format-deactivated": "Caffeine Mode: Inactive (Normal power saving)"
    },

    "custom/recorder": {
        "format": "{}",
        "return-type": "json",
        "interval": 1,
        "exec": "~/.config/waybar/scripts/recorder-status.sh",
        "on-click": "~/.config/hypr/scripts/screen-record.sh", // Same script stops it
        "signal": 8
    },

    "custom/power": {
        "format": "⏻ ",
        "tooltip": false,
        "on-click": "~/.config/waybar/scripts/sys-menu.sh"
    }
}